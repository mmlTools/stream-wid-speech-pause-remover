<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>StreamWID</AssemblyName>
    <RootNamespace>StreamWID</RootNamespace>
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets\Icons\app-icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="artifacts\**\*.cs" />
    <Compile Remove="Cli\**\*.cs" />
    <Compile Remove="obj\**\*.cs" />
    <Compile Remove="Tests\**\*.cs" />
    <EmbeddedResource Remove="artifacts\**" />
    <EmbeddedResource Remove="Cli\**" />
    <EmbeddedResource Remove="obj\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="artifacts\**" />
    <None Remove="Cli\**" />
    <None Remove="obj\**" />
    <None Remove="Tests\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Icons\app-icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.7" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.7" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.7" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.7" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\Icons\app-icon.png" />
  </ItemGroup>
</Project>
